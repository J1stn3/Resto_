# MySQL Server connection (required)
# Install: https://dev.mysql.com/downloads/mysql/
# Windows service name is usually MySQL80

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=pos_system

# API server
PORT=8080
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Tax rate (10% default)
TAX_RATE=0.10
